DATABASE_URL=postgresql+asyncpg://vectra:vectra@localhost:5432/vectra
REDIS_URL=redis://localhost:6379/0
TRAFFIC_DETECTION_CHANNEL=vectra.traffic.detection

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vectra
MINIO_SECRET_KEY=vectra123
MINIO_BUCKET=vectra-frames
MINIO_SECURE=false

# mock   = deterministic fake counts + boxes, zero setup (default)
# yolo   = real detection via Ultralytics YOLOv8n — lightweight, CPU-friendly
#          (uncomment its deps in requirements.txt first)
# rtdetr = real detection via RT-DETR (transformer) — heavy install (~2-4GB),
#          needs a GPU for real-time (uncomment its deps in requirements.txt
#          first; see app/detector.py's docstring before enabling)
DETECTOR=mock

LOG_LEVEL=INFO
